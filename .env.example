BACKEND_URL=https://ap.yourcompany.com

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Cloudflare Access — required for admin endpoint JWT validation
# CF_TEAM_DOMAIN: your Zero Trust team domain, e.g. yourcompany.cloudflareaccess.com
# CF_ACCESS_AUD: the Application Audience tag from CF Access > Applications > your app > Overview
CF_TEAM_DOMAIN=yourcompany.cloudflareaccess.com
CF_ACCESS_AUD=

TOKEN_EXPIRY_DAYS=7
AUTOPILOT_GROUP_TAG=autopilot-enrollment
SLACK_WEBHOOK_URL=
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_HOURS=24
